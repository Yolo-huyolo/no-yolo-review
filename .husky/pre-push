#!/usr/bin/env sh

# --- no-yolo-review: review the commits actually being pushed ---
# .husky/pre-commit (no-yolo-commits) already ran a fast single-pass review
# on every commit. This is the deeper multi-persona pass, at push time
# rather than every commit since a real fan-out+aggregate review is too
# slow to want blocking every local commit.
#
# Reviews the push RANGE (git diff <remote>..<local> per ref), not the
# whole repo (--all): an earlier version of this hook used --all, and it
# meant every single push re-reviewed this entire project's source from
# scratch — 5-10+ minutes of real LLM calls regardless of how small the
# actual change was. --all stays a manual-only audit command; hooks always
# review a diff. (This is the same fix already applied to fairlab_landing's
# pre-push — this hook just hadn't been brought in line with it yet.)
zero="0000000000000000000000000000000000000000"
diff_all=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue # deleting a ref — nothing to review

  if [ "$remote_sha" = "$zero" ]; then
    # New branch, no remote history for this ref yet — diff from where it
    # forked off the default branch, not its entire history.
    merge_base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" origin/master 2>/dev/null || true)"
    [ -z "$merge_base" ] && continue
    range="$merge_base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  chunk="$(git diff "$range" -- . ':(exclude)package-lock.json' 2>/dev/null || true)"
  if [ -n "$chunk" ]; then
    diff_all="${diff_all}${chunk}
"
  fi
done

if [ -z "$diff_all" ]; then
  exit 0
fi

# Prefer a globally-installed binary over `npx --yes`: npx fetches
# whatever's currently published on every single invocation with no
# pinning — no-yolo-review's own security persona flagged exactly that on
# itself (a compromised/typosquatted publish would get arbitrary code
# execution on every push). `npm install -g no-yolo-review` once avoids it;
# npx stays the fallback for a machine that hasn't done that yet.
run_review() {
  if command -v no-yolo-review >/dev/null 2>&1; then
    no-yolo-review "$@"
  elif command -v npx >/dev/null 2>&1; then
    npx --yes no-yolo-review "$@"
  else
    return 0
  fi
}

if command -v no-yolo-review >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then
  echo "→ Running no-yolo-review (full multi-persona pass) on the commits being pushed..."
  if ! printf '%s' "$diff_all" | run_review --html .no-yolo-review-report.html; then
    echo ""
    echo "⛔ no-yolo-review found blocking issues — see above, or open .no-yolo-review-report.html"
    echo "Push anyway with: git push --no-verify"
    exit 1
  fi
fi
